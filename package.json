{
  "name": "cobrowser",
  "displayName": "Cobrowser",
  "description": "An agent-controllable browser inside your editor — rendered offscreen by a companion app, co-driven by you (webview) and your AI agent (MCP).",
  "version": "0.9.26",
  "publisher": "trevin-lee",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trevin-lee/cobrowser.git"
  },
  "bugs": {
    "url": "https://github.com/trevin-lee/cobrowser/issues"
  },
  "homepage": "https://github.com/trevin-lee/cobrowser#readme",
  "icon": "media/store-icon.png",
  "keywords": [
    "browser",
    "mcp",
    "cdp",
    "agent",
    "automation",
    "cursor",
    "webview",
    "macos"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:cobrowser"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cobrowser.open",
        "title": "Cobrowser: Open Browser Panel"
      },
      {
        "command": "cobrowser.newTab",
        "title": "Cobrowser: New Browser Tab",
        "icon": "$(add)"
      },
      {
        "command": "cobrowser.openBrowser",
        "title": "Cobrowser: Open Browser",
        "icon": "media/icon.png"
      },
      {
        "command": "cobrowser.restartBrowser",
        "title": "Cobrowser: Restart Browser"
      },
      {
        "command": "cobrowser.connectAgent",
        "title": "Cobrowser: Connect Another Agent"
      },
      {
        "command": "cobrowser.copyFirefoxBridgeUrl",
        "title": "Cobrowser: Copy Bridge URL"
      },
      {
        "command": "cobrowser.bindFirefoxContainer",
        "title": "Cobrowser: Bind Firefox Container to This Workspace"
      },
      {
        "command": "cobrowser.showTab",
        "title": "Cobrowser: Show Tab"
      },
      {
        "command": "cobrowser.fillCard",
        "title": "Cobrowser: Fill Card",
        "icon": "$(credit-card)"
      },
      {
        "command": "cobrowser.manageLogins",
        "title": "Cobrowser: Open Vault"
      },
      {
        "command": "cobrowser.addLogin",
        "title": "Cobrowser: Add Login to Vault"
      },
      {
        "command": "cobrowser.importLoginsCsv",
        "title": "Cobrowser: Import Logins from CSV"
      },
      {
        "command": "cobrowser.exportLoginsCsv",
        "title": "Cobrowser: Export Logins to CSV"
      },
      {
        "command": "cobrowser.lockVault",
        "title": "Cobrowser: Lock Vault"
      },
      {
        "command": "cobrowser.installChromeBridge",
        "title": "Cobrowser: Install Chrome Bridge Extension"
      },
      {
        "command": "cobrowser.bindChromeTabGroup",
        "title": "Cobrowser: Bind Chrome Tab Group to This Workspace"
      },
      {
        "command": "cobrowser.closeTab",
        "title": "Cobrowser: Close Browser Tab"
      },
      {
        "command": "cobrowser.reloadTab",
        "title": "Cobrowser: Reload Tab"
      },
      {
        "command": "cobrowser.back",
        "title": "Cobrowser: Back"
      },
      {
        "command": "cobrowser.forward",
        "title": "Cobrowser: Forward"
      },
      {
        "command": "cobrowser.enablePasskeys",
        "title": "Cobrowser: Enable Passkeys (Sign the Browser)"
      },
      {
        "command": "cobrowser.disablePasskeys",
        "title": "Cobrowser: Turn Off Passkeys"
      },
      {
        "command": "cobrowser.sitePermissions",
        "title": "Cobrowser: Site Permissions for This Workspace"
      },
      {
        "command": "cobrowser.clearBrowsingData",
        "title": "Cobrowser: Clear Browsing Data for This Workspace"
      },
      {
        "command": "cobrowser.forgetWorkspace",
        "title": "Cobrowser: Forget Another Workspace's Browser"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "cobrowser.back", "when": "activeWebviewPanelId == 'cobrowser'" },
        { "command": "cobrowser.forward", "when": "activeWebviewPanelId == 'cobrowser'" },
        { "command": "cobrowser.reloadTab", "when": "activeWebviewPanelId == 'cobrowser'" },
        { "command": "cobrowser.closeTab", "when": "activeWebviewPanelId == 'cobrowser'" },
        { "command": "cobrowser.showTab", "when": "false" },
        { "command": "cobrowser.fillCard", "when": "activeWebviewPanelId == 'cobrowser'" }
      ],
      "editor/title": [
        {
          "command": "cobrowser.fillCard",
          "when": "activeWebviewPanelId == 'cobrowser'",
          "group": "navigation@99"
        },
        {
          "command": "cobrowser.newTab",
          "when": "activeWebviewPanelId == 'cobrowser'",
          "group": "navigation@100"
        },
        {
          "command": "cobrowser.openBrowser",
          "when": "activeWebviewPanelId != 'cobrowser'",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "cobrowser.newTab",
          "when": "view == cobrowser.sessions",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cobrowser",
          "title": "Cobrowser",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "cobrowser": [
        {
          "id": "cobrowser.sessions",
          "name": "Browser"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cobrowser.sessions",
        "contents": "No browser is running for this workspace. It starts when you open a tab, or when an agent uses a cobrowser tool.\n[Open Browser Panel](command:cobrowser.open)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "cobrowser.mcp",
        "label": "Cobrowser"
      }
    ],
    "configuration": {
      "title": "Cobrowser",
      "properties": {
        "cobrowser.port": {
          "type": "number",
          "default": 0,
          "scope": "application",
          "description": "Localhost port for the shared cobrowser daemon — the single MCP endpoint every editor window and every agent client uses. 0 (default) means 39273. It is set for the whole editor, so every window agrees on it; each window's own internal server takes an ephemeral port and is never contacted directly. Takes effect after reloading every window; paste the new Copy Bridge URL into a bridge extension's popup."
        },
        "cobrowser.accentColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#2b5bff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "A colour as #rrggbb, e.g. #2b5bff.",
          "scope": "application",
          "description": "The colour of what concerns the agent: its highlight in a browser tab, the frame it draws on tabs in your own Chrome or Firefox, and selection and the agent's switches in the vault. Cobalt (#2b5bff) by default. The logo keeps its own colours."
        },
        "cobrowser.uploadsWithoutAsking": {
          "type": "boolean",
          "default": false,
          "restricted": true,
          "markdownDescription": "Let the agent upload files in this workspace without asking you first (`upload_file`). Read from **Workspace** settings only, so it is never on everywhere at once, and ignored in an untrusted workspace. Each upload still shows a notification naming the files and the site, and hidden files and folders, `~/Library` (apart from iCloud Drive and cloud-storage folders) and cobrowser's own data are still refused."
        },
        "cobrowser.autoFallbackPasskeys": {
          "type": "boolean",
          "default": true,
          "description": "Install a virtual WebAuthn authenticator so passkey prompts fail fast to a password fallback. Ignored once the browser is signed for passkeys (Cobrowser: Enable Passkeys), which gives it the real Touch ID authenticator. Takes effect the next time the browser connects (Cobrowser: Restart Browser, or reload the window)."
        },
        "cobrowser.renderScale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "Device pixels rendered per CSS pixel. 2 is native on a Retina display and a 2x supersample on a 1x one — crisper text at the cost of larger frames. Backed off automatically on very large panels."
        },
        "cobrowser.renderBudgetMegapixels": {
          "type": "number",
          "default": 6.5,
          "minimum": 1,
          "maximum": 16,
          "description": "Largest frame the app will render, in megapixels. Above it the render scale is backed off. 6.5 keeps scrolling at ~30fps on a full-height Retina panel (~1.8x); 9 gives true 2x there at ~24fps. Measured on an M4 Pro."
        },
        "cobrowser.tabTitleMaxLength": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Longest browser tab title, in characters. Longer titles end with …, as in a browser; hovering the address bar shows the whole title. 0 shows titles in full."
        }
      }
    },
    "keybindings": [
      {
        "command": "cobrowser.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'cobrowser'"
      },
      {
        "command": "cobrowser.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'cobrowser'"
      },
      {
        "command": "cobrowser.reloadTab",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == 'cobrowser'"
      },
      {
        "command": "cobrowser.back",
        "key": "ctrl+[",
        "mac": "cmd+[",
        "when": "activeWebviewPanelId == 'cobrowser'"
      },
      {
        "command": "cobrowser.forward",
        "key": "ctrl+]",
        "mac": "cmd+]",
        "when": "activeWebviewPanelId == 'cobrowser'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node esbuild.test.mjs && node --test \"dist-test/*.test.js\"",
    "package": "vsce package",
    "package:chrome": "node scripts/pack-chrome-extension.mjs",
    "sign:firefox": "node scripts/sign-firefox-extension.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "release": "node scripts/release.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "bench:e2e": "node test/e2e/run.mjs --bench"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
