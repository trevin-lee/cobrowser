{
  "name": "cobrowser",
  "displayName": "Cobrowser",
  "description": "An agent-controllable browser inside your editor — rendered offscreen by a companion app, co-driven by you (webview) and your AI agent (MCP).",
  "version": "0.8.0",
  "publisher": "trevin-lee",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trevin-lee/cobrowser.git"
  },
  "bugs": {
    "url": "https://github.com/trevin-lee/cobrowser/issues"
  },
  "homepage": "https://github.com/trevin-lee/cobrowser#readme",
  "icon": "media/icon.png",
  "keywords": [
    "browser",
    "mcp",
    "cdp",
    "agent",
    "automation",
    "cursor",
    "webview",
    "puppeteer"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:cobrowser"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cobrowser.open",
        "title": "Cobrowser: Open Browser Panel"
      },
      {
        "command": "cobrowser.newTab",
        "title": "Cobrowser: New Browser Tab",
        "icon": "media/icon.png"
      },
      {
        "command": "cobrowser.restartBrowser",
        "title": "Cobrowser: Restart Browser"
      },
      {
        "command": "cobrowser.copyFirefoxBridgeUrl",
        "title": "Cobrowser: Copy Bridge URL"
      },
      {
        "command": "cobrowser.bindFirefoxContainer",
        "title": "Bind Firefox Container to This Workspace",
        "category": "Cobrowser"
      },
      {
        "command": "cobrowser.importProfiles",
        "title": "Cobrowser: Import Logins from Old Profiles"
      },
      {
        "command": "cobrowser.addLogin",
        "title": "Cobrowser: Add Login to Vault"
      },
      {
        "command": "cobrowser.importLoginsCsv",
        "title": "Cobrowser: Import Logins from CSV"
      },
      {
        "command": "cobrowser.lockVault",
        "title": "Cobrowser: Lock Vault"
      },
      {
        "command": "cobrowser.bindChromeTabGroup",
        "title": "Bind Chrome Tab Group to This Workspace",
        "category": "Cobrowser"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cobrowser.newTab",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "cobrowser.newTab",
          "when": "view == cobrowser.sessions",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cobrowser",
          "title": "Cobrowser",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "cobrowser": [
        {
          "id": "cobrowser.sessions",
          "name": "Browser"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "cobrowser.mcp",
        "label": "Cobrowser"
      }
    ],
    "configuration": {
      "title": "Cobrowser",
      "properties": {
        "cobrowser.port": {
          "type": "number",
          "default": 0,
          "description": "Localhost port for the shared cobrowser daemon — the single MCP endpoint every editor window and every agent client uses. 0 (default) means 39273. All windows must agree on this value; each window's own internal server takes an ephemeral port and is never contacted directly."
        },
        "cobrowser.autoFallbackPasskeys": {
          "type": "boolean",
          "default": true,
          "description": "Install a virtual WebAuthn authenticator so passkey prompts fail fast to a password fallback. The browser renders offscreen, so a real passkey ceremony has no window to show the OS prompt in and would hang."
        },
        "cobrowser.firefoxContainer": {
          "type": "string",
          "default": "",
          "description": "Fallback binding for the Firefox bridge. PREFER the command \"Cobrowser: Bind Firefox Container to This Workspace\", which stores the choice per workspace without writing a .vscode/settings.json into your repo. Works with Firefox and its forks (Zen, LibreWolf, Floorp) — anything with containers and managed storage."
        },
        "cobrowser.zenContainer": {
          "type": "string",
          "default": "",
          "description": "Deprecated: renamed to cobrowser.firefoxContainer. Still honoured as a fallback so existing configurations keep working.",
          "deprecationMessage": "Renamed to cobrowser.firefoxContainer — the bridge is a plain Firefox WebExtension, not Zen-specific. Still honoured as a fallback."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "node esbuild.test.mjs && node --test \"dist-test/*.test.js\"",
    "package": "vsce package",
    "sign:firefox": "node scripts/sign-firefox-extension.mjs",
    "publish:ovsx": "ovsx publish",
    "vscode:prepublish": "node esbuild.mjs --production",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^24.10.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.2",
    "ovsx": "^0.10.0",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
