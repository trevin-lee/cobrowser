# Source & build config (dist/ is shipped; sources are not)
src/**
webview-src/**
esbuild.mjs
tsconfig*.json
.vscode/**
.gitignore
**/*.map
# SECRETS — these are generated at activation and carry the live MCP port + Bearer
# token. They are git-excluded but vsce does not read .gitignore, so without these
# lines a packaged VSIX ships a real session token to everyone who installs it.
.cursor/**
.mcp.json
# Dev-only: CI config, release tooling, and the transient handoff note.
.github/**
scripts/**
HANDOFF.md
# Everything the extension needs is bundled into dist/, so no node_modules ship.
node_modules/**
# The app ships as dist/app/main.js (bundled); its source tree and node_modules do not.
app/**
# Source art for media/cobrowser.icns (scripts/make-icon.js); the .icns is what ships.
media/cobrowser-1024.png
# Tests are for the repo, not the installed extension.
test/**
dist-test/**
esbuild.test.mjs
dist-e2e/**
